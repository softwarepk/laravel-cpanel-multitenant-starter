APP_NAME="Multi-Tenant Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Defaults to true when APP_ENV=production. Set explicitly only to override.
# FORCE_HTTPS=true

# Managed by the production first-run web installer. Existing deployments with a
# configured APP_KEY are treated as already installed for backward compatibility.
INSTALLATION_COMPLETE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Central / landlord database. SQLite keeps first-run development simple.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Production tenant databases normally use the same cPanel MySQL/MariaDB server.
# TENANT_DB_USERNAME is both the Laravel tenant DB login and the cPanel MySQL user
# that receives privileges on each provisioned tenant database.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=
TENANT_DB_PASSWORD=

# Tenant requests are resolved before sessions/cache are loaded. Database-backed
# sessions and cache therefore follow the active tenant database; central requests
# continue to use the central database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Queue records stay in the central database. stancl/tenancy adds the originating
# tenant ID to tenant-aware payloads and restores tenant context in the worker.
# Tenant provisioning/deletion are queued and need a worker. Keep retry_after
# comfortably above the 600-second tenant-operation job timeout.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=900
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FORTIFY_REGISTRATION=false
FORTIFY_EMAIL_VERIFICATION=true

# Central control-plane host(s), comma separated.
CENTRAL_DOMAINS=127.0.0.1,localhost

# Permanent tenant hostnames become <tenant-id>.<TENANT_PLATFORM_DOMAIN>.
TENANT_PLATFORM_DOMAIN=tenants.example.com
TENANT_PLATFORM_DOCUMENT_ROOT=
CUSTOM_DOMAIN_DNS_TARGET=

# cPanel provisioning. CPANEL_API_USER is the cPanel account/API user; it is
# intentionally separate from the MySQL TENANT_DB_USERNAME above.
CPANEL_TENANT_DB_PREFIX=
CPANEL_API_HOST=
CPANEL_API_PORT=2083
CPANEL_API_USER=
CPANEL_API_TOKEN=
CPANEL_API_CONNECT_TIMEOUT=5
CPANEL_API_TIMEOUT=90

VITE_APP_NAME="${APP_NAME}"
